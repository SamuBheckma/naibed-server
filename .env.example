# Copie para .env (scripts/preparar.sh faz isso e gera a APP_KEY). Nunca versione o .env.

# Nome exibido no painel (troque à vontade).
PAINEL_NOME="Painel pessoal"

APP_ENV=production
APP_DEBUG=false
# Gerada UMA vez por scripts/preparar.sh e nunca sobrescrita. Se a perder, as sessões
# deixam de valer (as senhas continuam funcionando).
APP_KEY=
APP_URL=http://127.0.0.1:8081
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# Logs: um arquivo por dia em storage/logs, mantendo os últimos N dias.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Banco e sessões (o compose já define DB_DATABASE para o volume persistente).
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Deixe false no acesso por túnel SSH (http://127.0.0.1) e por onion (http://...onion).
# Use true somente se houver HTTPS de ponta a ponta; com true em HTTP o login não "gruda".
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Atalhos. O endereço precisa abrir no DISPOSITIVO DO VISITANTE (p.ex. o .onion do Jellyfin).
# localhost e 127.0.0.1 são rejeitados. Vazio = "Endereço não configurado".
PAINEL_JELLYFIN_URL=
# Atalhos extras (opcional), JSON em uma linha, entre aspas simples:
# PAINEL_ATALHOS='[{"titulo":"Wiki","descricao":"Notas","url":"https://exemplo.onion/"}]'
PAINEL_ATALHOS=
